{
  "name": "cap82-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cap 82-0 en application de bureau Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "ca.local.cap82",
    "productName": "Cap 82-0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "site",
        "filter": [
          "index.html",
          "style.css",
          "sw.js",
          "site.webmanifest",
          "favicon.svg",
          "icon-*.png",
          "js/**/*",
          "data/**/*",
          "!data/salaries/**",
          "fonts/**/*",
          "img/**/*"
        ]
      }
    ],
    "win": {
      "icon": "../icon-512.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Cap-82-0-portable.exe"
    },
    "nsis": {
      "artifactName": "Cap-82-0-installateur.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cap 82-0"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "author": "Jean-Philippe Ouellette"
}
